# SuperAtom Web SDK Configuration
# These environment variables configure the frontend SDK

# User ID - identifies the current user for conversations and bookmarks
VITE_USER_ID=user

# Project ID - your SuperAtom project identifier (required)
# Get this from your SuperAtom dashboard or backend configuration
VITE_SUPERATOM_PROJECT_ID=your-project-id

# WebSocket URL - SuperAtom WebSocket server for real-time communication
# Production: wss://ws.superatom.ai/websocket
# Local development with backend: ws://localhost:3000/websocket (if using local backend)
VITE_SUPERATOM_WS_URL=wss://ws.superatom.ai/websocket

# Debug mode - enables verbose logging in the SDK (true/false)
VITE_DEBUG=false

# Mapbox access token - used by DynamicMapboxMapView (shared-modules/DynamicMapboxMapView).
# This ships in the browser bundle, so it MUST be a public "pk." token from
# https://account.mapbox.com/access-tokens/ — never an "sk." secret token.
VITE_MAPBOX_TOKEN=pk.your-public-mapbox-token
