{
  "name": "superatom-backend",
  "version": "1.0.0",
  "description": "IKEA Data Visualization Application Backend API",
  "main": "dist/backend/src/app.js",
  "scripts": {
    "dev": "nodemon --ignore scripts-store/ --exec ts-node src/app.ts",
    "dev:sa": "ts-node src/sa.ts",
    "build": "tsc",
    "start": "node dist/backend/src/app.js",
    "type-check": "tsc --noEmit",
    "contract:mirror": "ts-node scripts/check-contract-mirror.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/run-migrations.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.15.0",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1081.0",
    "@aws-sdk/lib-dynamodb": "^3.1081.0",
    "@duckdb/node-api": "1.4.4-r.1",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@neondatabase/serverless": "^1.0.2",
    "@redactpii/node": "^1.0.17",
    "@superatomai/sdk-node": "0.0.76-dsp",
    "@types/pg": "^8.15.6",
    "chromadb": "^1.8.1",
    "chromadb-default-embed": "^2.14.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.25.12",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "fast-csv": "4.3.6",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "mssql": "^11.0.1",
    "mysql2": "^3.23.1",
    "pg": "^8.16.3",
    "unzipper": "^0.10.14",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.9.2",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.7",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.4",
      "@protobufjs/utf8": "^1.1.1",
      "body-parser": "^2.3.0",
      "brace-expansion": "^5.0.12",
      "esbuild": "^0.28.1",
      "form-data": "^4.0.6",
      "path-to-regexp": "^8.4.0",
      "picomatch": "^2.3.2",
      "protobufjs": "^7.6.3",
      "qs": "^6.16.0",
      "undici": "^8.11.2",
      "uuid": "^11.1.1"
    }
  }
}
