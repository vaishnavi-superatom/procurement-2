superatom-sdk.log

# Uploaded files (Excel/CSV)
uploads/

# Generated DuckDB databases + build-cache sidecars (Excel/CSV sources)
duckdb/

# Script flow runtime store (LLM-authored .ts scripts + metadata, per-environment)
scripts-store/

# Generated per-deployment proxy id for the cross-machine source proxy
.proxy-id

# This engine's id and the composition graph release it applied (services/graph-replica.ts)
.engine-state.json

# OS-redirected temp files (Excel/CSV unzip scratch — see src/temp-dir.ts)
tmp/

# Dashboard agent (Pi) runtime state — regenerated per session, per-machine;
# AGENTS.md itself lives in .prompts/dashboard-agent/ and IS version-controlled.
.pi-dashboard-agent-runtime/

# Coding-agent workspaces and session/trigger state — regenerated per run,
# per-machine. Each agent's system.md lives in .prompts/coding-agents/ and IS
# version-controlled.
.coding-agent-runtime/

# Per-iteration diagnostic scripts (_run-*, _check-*, _test-*). Kept on disk for
# re-running against a live backend, out of the branch — same convention as
# sdk-nodejs. Anything worth keeping graduates to scripts/ with real arguments.
/_*.ts

# Narrator output (the latest question only), see src/coding-agents/narrator/
narration-log.jsonl

# Dashboard-builder agent workspaces — one per dashboard, re-synced from what is
# published whenever a session opens. The conversation itself lives under
# ~/.pi, so nothing here is the only copy. AGENTS.md lives in
# .prompts/dashboard-builder/ and IS version-controlled.
.dash-builder-runtime/

# The backend's cache (SQLite): query results and resolver answers. Safe to
# delete, never the only copy of anything. See src/services/cache-db.ts.
.sa-cache/

# Published dashboard programs — generated by the builder agent, per-deployment.
# The contract, the runtime and the prompt are version-controlled; what an agent
# wrote for one project's data is not.
dashboard-programs/
