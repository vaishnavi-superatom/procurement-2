# =============================================================================
# backend/.env — every setting the backend, its scripts and the SDK read.
#
# Copy to .env and fill in. Only the REQUIRED section must be set to start;
# everything else has a working default (shown) and is commented out.
# Values must not contain unquoted spaces or '#'; quote a value that does.
# =============================================================================


# =============================================================================
# REQUIRED
# =============================================================================

# The project this deployment serves. Both come from the platform (Projects →
# API key). The backend refuses to start without SUPERATOM_PROJECT_ID.
SUPERATOM_API_KEY=your_superatom_api_key
SUPERATOM_PROJECT_ID=your-project-id

# The app's own Postgres: users, threads, conversations, concepts, the routing
# graph, sources, reports. Shared with database/postgres (same value as its .env).
# Every script in backend/scripts/ (concepts-load, graph-seed, graph-import…)
# writes HERE — check it before running one.
PROJECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_data

# At least ONE LLM key. On a client deployment use only OPENROUTER_API_KEY
# with the proxy below; the others are for local development.
OPENROUTER_API_KEY=your_openrouter_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
# GROQ_API_KEY=your_groq_api_key
# GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key


# =============================================================================
# LLM ROUTING
# =============================================================================

# A per-client proxy key (starts with `sk-prox-`) only works through Superatom's
# LLM proxy — set this whenever OPENROUTER_API_KEY is one, or every model call
# fails (the backend refuses to start and says so). Leave unset for a real
# OpenRouter key.
# SUPERATOM_LLM_PROXY_URL=https://ai.superatom.ai

# With OPENROUTER_API_KEY set and no ANTHROPIC_API_KEY, Claude calls go through
# OpenRouter. Override the endpoint only for a non-standard gateway.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Which upstream hosts OpenRouter tries for Claude, in order.
# OPENROUTER_PROVIDER_ORDER=Anthropic,Amazon Bedrock,Google Vertex

# Restrict the SDK's providers (JSON array). Normally derived from which keys
# are set — only set to force a subset.
# LLM_PROVIDERS=["anthropic","gemini","openai","groq"]


# =============================================================================
# ANSWER FLOW — how a chat question is answered
# =============================================================================

# Default (unset): answers come from the answer-agent coding agent (codex),
# working in a per-thread workspace with the shared data tools.
# `agents` → the SDK's older built-in MainAgent + SourceAgent instead.
# SA_ANSWER_FLOW=agents

# Harness the SDK runs coding agents on. The answer agent runs on codex, which
# needs a Codex/ChatGPT login on this machine.
# CODING_AGENT_HARNESS=codex

# The answer agent's model (default gpt-6-luna, which needs codex >= 0.156).
# SA_ANSWER_AGENT_MODEL sets this agent only; CODEX_AGENT_MODEL sets every
# coding agent. Use an older model, e.g. gpt-5.6-sol, if codex is older.
# SA_ANSWER_AGENT_MODEL=gpt-6-luna
# CODEX_AGENT_MODEL=

# Codex sandbox for the answer agent: read-only | workspace-write | danger-full-access.
# Keep workspace-write: the agent writes data/ and answer.md in its workspace and
# nothing outside it. danger-full-access only to debug a sandbox problem.
# ANSWER_AGENT_SANDBOX_MODE=workspace-write

# Where the SDK keeps coding-agent workspaces and how many threads' workspaces it
# keeps before pruning the oldest.
# CODING_AGENT_RUNTIME_DIR=./.coding-agent-runtime
# CODING_AGENT_KEEP_THREADS=200
# Override where agent prompts are read from (default: the agent's own .prompts dir).
# CODING_AGENT_PROMPT_DIR=

# Domain routing, ON by default: each question is matched to a domain of the
# composition graph (graph_* tables, seeded by scripts/graph-seed.ts +
# graph-import.ts) and the agent gets that domain's concepts and instructions.
# An empty graph composes nothing. `off` → every question uses the plain
# system.md prompt.
# SA_GRAPH_ROUTING=off
# Model that breaks a near-tie between two domains.
# SA_ROUTER_MODEL=openrouter/anthropic/claude-haiku-4.5

# Turns the agent's :::graph specs into chart components.
# SA_UI_AGENT_MODEL=openrouter/deepseek/deepseek-v4.1-flash

# Background agent that proposes new concepts from answered questions (they land
# unverified, for review). Off by default: it spends model calls and changes the
# concept store while you are working. `on` to enable.
# SA_CONCEPT_BUILDER=off

# Graph replication, off by default. `on` → the graph and concepts are authored
# on the platform and this deployment mirrors them: at startup and every
# SA_GRAPH_RECHECK_MS it REPLACES the local graph and concepts with the
# platform's. Anything seeded locally (graph-import, concepts-load) is wiped —
# and every branch run against the same database sees the result. Leave off
# unless this deployment should follow the platform.
# SA_GRAPH_REPLICATION=on
# SA_GRAPH_RECHECK_MS=300000
# Where the last replicated version is remembered.
# SA_ENGINE_STATE_FILE=./.engine-state.json


# =============================================================================
# NARRATOR — the short "what I'm doing" updates shown while an answer runs
# =============================================================================

# `off` disables it (no updates, no warm-up at startup).
# SA_NARRATOR=on
# Its own small model — fast and cheap; it never touches data.
# NARRATOR_PROVIDER=openrouter
# NARRATOR_MODEL=deepseek/deepseek-v4.1-flash
# At most one update per this many ms.
# NARRATOR_INTERVAL_MS=5000


# =============================================================================
# NUMBERS & MONEY
# =============================================================================

# How answers, tables and the narrator write numbers and money. en-IN + INR →
# lakh/crore (₹2.35 Cr); en-US + USD → million/billion ($2.35M).
# SA_LOCALE=en-IN
# SA_CURRENCY=INR


# =============================================================================
# DASHBOARDS
# =============================================================================

# Dashboard builder (pi). `openai-codex` runs on a ChatGPT login made once with
# the pi CLI (`pi`, then `/login`).
# PI_PROVIDER=openai-codex
# PI_MODEL=gpt-5.6-luna
# A builder session idle this long is closed.
# DASH_BUILDER_IDLE_MS=1800000
# Where generated dashboard programs are stored.
# DASH_PROGRAMS_DIR=./dashboard-programs
# Model that composes dashboard components.
# DASH_COMP_MODEL=openrouter/anthropic/claude-sonnet-4.5

# The SDK's own pi dashboard agent (separate from the builder above).
# PI_AGENT_PROVIDER=
# PI_AGENT_MODEL=
# PI_AGENT_DIR=./.prompts/dashboard-agent
# PI_AGENT_RUNTIME_DIR=./.pi-dashboard-agent-runtime
# `false` reuses the previous session instead of starting fresh each time.
# PI_AGENT_FRESH_SESSION=true
# PI_AGENT_IDLE_MS=1800000


# =============================================================================
# OLDER BUILT-IN AGENTS (used only with SA_ANSWER_FLOW=agents)
# =============================================================================

# MAIN_AGENT_MODEL=openrouter/anthropic/claude-haiku-4.5
# SOURCE_AGENT_MODEL=openrouter/anthropic/claude-haiku-4.5
# `true` skips matching a question to a saved script (explicit edits still match).
# SA_SKIP_SCRIPT_MATCH=false
# A question asked again within this many hours replays the saved answer. 0 = never.
# SA_ANSWER_REPLAY_MAX_AGE_HOURS=24


# =============================================================================
# DATA SOURCES
# =============================================================================

# SQL dialect the agents write. Options: postgresql, mssql.
DATABASE_TYPE=postgresql

# A Postgres the project queries directly (legacy direct-DB path). Not the app
# database — that is PROJECT_DATABASE_URL. Leave unset if your data is connected
# as a source in the UI.
# DATABASE_URL=postgresql://user:password@localhost:5432/your_project_db

# Microsoft SQL Server (legacy direct path; collections mssql-database.execute /
# .mutation). Sources added in the UI do not need these.
# Option 1: connection string
# MSSQL_CONNECTION_STRING=mssql://user:password@server/database
# Option 2: individual parts
# MSSQL_SERVER=localhost
# MSSQL_DATABASE=your_database
# MSSQL_USER=sa
# MSSQL_PASSWORD=your_password
# MSSQL_PORT=1433
# MSSQL_ENCRYPT=false
# MSSQL_TRUST_CERT=true
# MSSQL_CONNECTION_TIMEOUT=30000
# MSSQL_REQUEST_TIMEOUT=60000
# AES-256-GCM key (base64, exactly 32 bytes) encrypting secret source fields at
# rest (e.g. a NetSuite private key). Required only for a source with a secret
# field. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Do not change it once set — existing encrypted fields become unreadable.
# SOURCE_SECRET_ENCRYPTION_KEY=

# Query-result cache (SQLite) location.
# SA_CACHE_DB=./.sa-cache/cache.sqlite
# Key that encrypts the query-id tokens the SDK hands out. Set a private value
# in production (the default is a fixed public string).
# QUERY_TOKEN_SECRET=


# =============================================================================
# SCRIPTS & THE AGENT'S DATA BRIDGE
# =============================================================================

# How long one analysis script may run, ms. Raise for slow sources.
# SCRIPT_TIMEOUT_MS=60000
# Scripts run at once (default: CPUs-1, between 2 and 8) and how many may wait.
# SCRIPT_MAX_CONCURRENCY=
# SCRIPT_MAX_QUEUE=100
# Largest result a script may return, bytes (64 MB).
# SCRIPT_MAX_IPC_BYTES=67108864

# Local port the agent's tools call to query data. 0/unset = any free port.
# Pin it only to debug; a pinned port that is taken stops the backend.
# SCRIPT_BRIDGE_PORT=0
# Set by the backend itself at startup — do not set.
# SCRIPT_BRIDGE_URL=


# =============================================================================
# SQL AUTHORIZATION (AST rewrite) — see docs/SQL-AUTHORIZATION-DESIGN.md
# =============================================================================

# One switch:
#   off      rewriter never consulted.
#   shadow   (default) rewrite and log differences, but run the ORIGINAL SQL —
#            behaviour-neutral. Grep "[sqlrewrite:shadow] rewrite differs".
#   enforce  run the REWRITTEN SQL with each user's row-level policies, and
#            refuse any query with no request context. Before switching, grep
#            shadow logs for "[policy-gate] anonymous query" — each becomes a
#            refusal. Users with no policy are unaffected.
# Policies are set per user in the admin UI (Projects → Manage Members →
# Config); give each a short "label" — the agent says it to the user.
# Needs python3 (vendored SQLGlot in backend/sqlrewrite/).
# SA_SQL_REWRITE_MODE=shadow
# SA_SQL_REWRITE_PYTHON=python3
# SA_SQL_REWRITE_POOL_SIZE=2
# SA_SQL_REWRITE_TIMEOUT_MS=5000
# SA_SQL_REWRITE_IDLE_MS=300000
# SA_SQL_REWRITE_DIR=./sqlrewrite
# SA_SQL_POLICY_ENFORCE is retired and ignored — use SA_SQL_REWRITE_MODE=enforce.


# =============================================================================
# PLATFORM (SA-API) & CROSS-MACHINE PROXY
# =============================================================================

# SA-API. Required for R2-backed file sources (Excel/CSV uploaded to R2) — the
# backend downloads them by r2Key — for files attached to a chat question
# (downloaded into the agent's workspace, removed from R2 with the thread),
# and for chat analytics.
# SA_API_URL=https://your-api.superatom.ai
# Shared secret matching the SA-API worker.
# SA_INTERNAL_SERVICE_TOKEN=your_internal_service_token
# Organisation id, for analytics.
# SA_ORG_ID=your_organization_uuid
# `false` turns chat analytics off.
# SA_ANALYTICS_ENABLED=true
# Where answer feedback (thumbs) is forwarded; unset = kept locally only.
# SA_API_BASE_URL=https://your-api.superatom.ai

# The project's Durable Object websocket — the SDK connection and the
# cross-machine source proxy (a script here can read a source connected on
# another deployment of the same project; see docs/cross-machine-source-proxy.md).
# SA_WEBSOCKET_URL=wss://ws.superatom.ai/websocket
# `false` disables the proxy.
# SA_PROXY_ENABLED=true
# Stable id for this deployment; unset = generated once into .proxy-id.
# SA_PROXY_ID=ec2-prod-1
# SA_PROXY_ID_FILE=./.proxy-id


# =============================================================================
# REPORTS, ALERTS & EMAIL
# =============================================================================

# Email links go to https://{SA_ORG_SLUG}.{SA_APP_BASE_DOMAIN}, so recipients
# land in their org. setup.sh writes SA_ORG_SLUG; set it manually to override.
# SA_ORG_SLUG=acme
# SA_APP_BASE_DOMAIN=superatom.ai
# Fallback link base when SA_ORG_SLUG is unset (also the alert "Dig Deeper" link).
CHAT_AGENT_BASE_URL=https://dev.live.superatom.ai

# Resend sends report and alert emails.
RESEND_API_KEY=re_xxxxxxxxxxxxx
ALERT_FROM_EMAIL=alerts@superatom.ai

# `false` turns a scheduler off; intervals in ms.
# REPORT_SCHEDULE_ENABLED=true
# REPORT_SCHEDULER_INTERVAL_MS=300000
# ALERT_CHECK_ENABLED=true
# ALERT_SCHEDULER_INTERVAL_MS=300000


# =============================================================================
# SERVER, LOGS & HOUSEKEEPING
# =============================================================================

PORT=3000
NODE_ENV=development

# Built frontend assets the SDK serves.
BUNDLE_DIR=../frontend/dist/assets
# SA_BUNDLE_DIR=
# Where the SDK reads prompts from.
# PROMPTS_DIR=./.prompts

# errors | warnings | info | verbose
# SUPERATOM_LOG_LEVEL=info
# `1` logs every LLM tool call (noisy; debugging only).
# SA_DEBUG_LLM_TOOLS=0
# Per-call LLM usage log; `false` to stop writing it.
# LLM_USAGE_LOGGING=true
# LLM_USAGE_LOG_PATH=./llm-usage-logs.log
# Failed chat requests are logged here; `false` to stop.
# USER_PROMPT_ERROR_LOGGING=true
# USER_PROMPT_ERROR_LOG_PATH=./user-prompt-req-errors

# conversation_traces is capped at TRACE_MAX_ROWS per type, checked every interval.
# TRACE_CLEANUP_ENABLED=true
# TRACE_CLEANUP_INTERVAL_MS=300000
# TRACE_MAX_ROWS=1000


# =============================================================================
# ONE-OFF SCRIPTS ONLY (backend/scripts/) — the server never reads these
# =============================================================================

# PROJECT_ID=                       fallback for SUPERATOM_PROJECT_ID in db-bridge-query / index-location-hierarchy
# SA_ANALYSIS_DIR=../analysis/data  apply-semantic-model input
# SCRIPTS_STORE_DIR=                delete-script-bodies target
# COLLECTION_NAME=                  sync-kb-nodes-from-prod
# PG_HOST=localhost                 add-test-sources (with PG_PORT, PG_USER, PG_PASSWORD, PG_DATABASE)
# EXCEL_FILE_PATH=                  add-test-sources
