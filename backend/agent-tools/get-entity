#!/usr/bin/env bash
# get-entity — one entity, and how to filter on it in SQL.
#
#   get-entity --type customer 10502          that record: values, attrs, mapping
#   get-entity --type customer --name "ACME"  resolve the name first
#   get-entity --type customer                describe the type: id/value columns
#
# The mapping is what makes a WHERE clause writable: it names the table and the
# id column the resolved id belongs to. Ids come from find-entity.
set -euo pipefail

[ -n "${SA_BRIDGE_URL:-}" ] || { echo "get-entity: SA_BRIDGE_URL is not set — this run has no backend." >&2; exit 2; }

args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --type)    args+=(--data-urlencode "type=${2:-}"); shift 2 ;;
    --name)    args+=(--data-urlencode "name=${2:-}"); shift 2 ;;
    *)         args+=(--data-urlencode "id=$1");       shift ;;
  esac
done

curl -sS --get "$SA_BRIDGE_URL/tools/get-entity" \
  ${SA_CONTEXT_TOKEN:+-H "x-sa-context: $SA_CONTEXT_TOKEN"} \
  "${args[@]}"
