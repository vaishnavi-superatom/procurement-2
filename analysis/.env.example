# PostgreSQL Database connection URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/your_database

# ============================================
# Microsoft SQL Server Configuration
# ============================================
# Option 1: Connection string (takes precedence)
# MSSQL_CONNECTION_STRING=mssql://user:password@server/database

# Option 2: Individual components
MSSQL_SERVER=localhost
MSSQL_DATABASE=your_database
MSSQL_USER=sa
MSSQL_PASSWORD=your_password
# MSSQL_PORT=1433  # Default is 1433
# MSSQL_DRIVER=ODBC Driver 17 for SQL Server  # Default driver
