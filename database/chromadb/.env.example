# PostgreSQL Connection (uses project_data database with kb_nodes table)
# Same connection string as database/postgres
PROJECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_data

# ChromaDB Server Settings
CHROMA_SERVER_URL=http://localhost:8000

# Collection Names
# knowledge_base_collection - stores embeddings from kb_nodes table
# user_conversations_collection - stores embeddings of user prompts (used by backend)
# components_collection - stores embeddings of display components for semantic search
# bookmarks_collection - stores embeddings of user bookmarks for personalized suggestions
# schema_tables_collection - stores per-table embeddings (for pre-SourceAgent schema search)
# source_summaries_collection - stores per-source embeddings (for pre-MainAgent routing)
COLLECTION_NAME=knowledge_base_collection
USER_CONVERSATIONS_COLLECTION_NAME=user_conversations_collection
COMPONENTS_COLLECTION_NAME=components_collection
BOOKMARKS_COLLECTION_NAME=bookmarks_collection
SCHEMA_TABLES_COLLECTION_NAME=schema_tables_collection
SOURCE_SUMMARIES_COLLECTION_NAME=source_summaries_collection

# Knowledge Base Table (default: kb_nodes)
KB_TABLE_NAME=kb_nodes
